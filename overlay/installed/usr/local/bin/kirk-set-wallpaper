#!/bin/sh
# One-shot: set the wallpaper on a user's first Plasma login.
flag="$HOME/.config/kirk-wallpaper-done"
[ -e "$flag" ] && exit 0
sleep 8
if command -v plasma-apply-wallpaperimage >/dev/null 2>&1 &&
   plasma-apply-wallpaperimage /usr/share/backgrounds/kirk-arch.svg; then
  mkdir -p "$HOME/.config"; touch "$flag"
fi
exit 0
