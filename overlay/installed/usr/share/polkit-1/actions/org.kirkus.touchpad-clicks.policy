<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>kirkus</vendor>
  <action id="org.kirkus.touchpad-clicks">
    <description>Change whether the touchpad's physical clicks are used</description>
    <message>Authentication is required to change the touchpad click setting</message>
    <icon_name>input-touchpad</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/bin/kirk-touchpad-clicks-apply</annotate>
  </action>
</policyconfig>
