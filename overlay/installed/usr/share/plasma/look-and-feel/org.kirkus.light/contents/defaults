# The kirkus Light Global Theme: what "Apply" in System Settings → Global Theme sets, and what a
# new account starts with. Plasma style and window borders are KDE's Breeze, which take their
# colours from kirkus Light. The dark twin is org.kirkus.splash.

[kdeglobals][KDE]
widgetStyle=Breeze

[kdeglobals][General]
ColorScheme=KirkusLight

[kdeglobals][Icons]
Theme=breeze

[plasmarc][Theme]
name=default

[Wallpaper]
Image=kirkus

[kcminputrc][Mouse]
cursorTheme=breeze_cursors

[kwinrc][org.kde.kdecoration2]
library=org.kde.breeze
theme=Breeze

[kwinrc][WindowSwitcher]
LayoutName=org.kde.breeze.desktop

[kwinrc][DesktopSwitcher]
LayoutName=org.kde.breeze.desktop

[ksplashrc][KSplash]
Theme=org.kirkus.splash
