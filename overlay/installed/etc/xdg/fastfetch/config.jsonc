// kirkus: fastfetch with the kirkus bird and the brand colours.
// If you create your own ~/.config/fastfetch/config.jsonc, it takes priority over this file.
// The same config is also installed as a preset: fastfetch -c kirkus
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/usr/share/kirkus/fastfetch-logo.txt",
    // $1 = Marigold bird, $2 = Bone (raw ANSI truecolour: 38;2;R;G;B)
    "color": { "1": "38;2;242;169;59", "2": "38;2;243;239;230" },
    "padding": { "top": 1, "left": 1, "right": 3 }
  },
  "display": {
    "color": { "keys": "38;2;242;169;59", "title": "38;2;243;239;230" }
  },
  "modules": [
    "title", "separator",
    "os", "host", "kernel", "uptime", "packages", "shell",
    "display", "de", "wm", "theme", "icons", "font", "terminal",
    "cpu", "gpu", "memory", "swap", "disk", "battery", "locale",
    "break", "colors"
  ]
}
