#!/bin/sh
# Live USB: switch to Broadcom's 'wl' driver only on computers whose Wi-Fi chip needs it
# (see kirk-detect). Everything else keeps the kernel's own drivers.
eval "$(/usr/local/bin/kirk-detect)"
[ "$KIRK_BROADCOM_WL" = yes ] || exit 0
echo "kirk-live-wifi: $KIRK_WL_DEVICE found, using the wl driver"
# /run/modprobe.d is read like /etc/modprobe.d, so this also stops udev loading them again later
mkdir -p /run/modprobe.d
cp /usr/share/kirkus/broadcom-wl-blacklist.conf /run/modprobe.d/broadcom-wl.conf
modprobe -r b43 b43legacy brcmsmac bcma ssb 2>/dev/null
modprobe wl
